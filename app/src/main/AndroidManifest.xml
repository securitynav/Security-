<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.securitynav.security">

    <!-- Permisos para análisis de tráfico y VPN -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Permisos para detección de sabotaje celular -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PRECISE_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permisos para auditoría de espionaje de pantalla -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.GET_INSTALLED_APPS" />

    <!-- Permisos de accesibilidad y monitoreo -->
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Permisos generales -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Permisos de cámara y micrófono para detección -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Permisos de información del sistema -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.GET_DETAILED_TASK_INFO" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- Permisos de registro y auditoría -->
    <uses-permission android:name="android.permission.CHANGE_DEVICE_ADMIN" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SecurityNav"
        android:usesCleartextTraffic="false"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true">

        <!-- Actividad de registro principal -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad principal -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <!-- Dashboard de seguridad -->
        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- VPN Service para captura de tráfico -->
        <service
            android:name=".services.TrafficMonitorService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Foreground Service para operación continua -->
        <service
            android:name=".services.SecurityMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Servicio de detección de sabotaje celular -->
        <service
            android:name=".services.CellularSabotageDetectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Servicio de auditoría de espionaje -->
        <service
            android:name=".services.ScreenSpyAuditService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Servicio de accesibilidad para monitoreo avanzado -->
        <service
            android:name=".services.AccessibilityMonitoringService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Content Provider para base de datos cifrada -->
        <provider
            android:name=".data.SecurityDataProvider"
            android:authorities="com.securitynav.security.provider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Receptor de eventos de sistema -->
        <receiver
            android:name=".receivers.SystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.AIRPLANE_MODE" />
                <action android:name="android.net.wifi.STATE_CHANGE" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Receptor de llamadas telefónicas -->
        <receiver
            android:name=".receivers.PhoneStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>

        <!-- Receptor de cambios de conectividad -->
        <receiver
            android:name=".receivers.ConnectivityReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.net.wifi.STATE_CHANGE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
