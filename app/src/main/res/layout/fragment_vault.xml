<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Key Vault (SQLCipher)"
        android:textColor="@color/neon_yellow"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Highly encrypted storage for API keys and sensitive security events using SQLCipher 256-bit AES."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnUnlockVault"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:text="Unlock Vault"
        android:backgroundTint="@color/neon_yellow"
        android:textColor="@color/black"
        android:paddingHorizontal="32dp" />
</LinearLayout>
