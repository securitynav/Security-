<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SecurityNav"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#38BDF8"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acceso al Almacén Cifrado SQLCipher"
        android:textSize="14sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/etMasterPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Clave Maestra de Cifrado"
        android:inputType="textPassword"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:padding="16dp"
        android:background="#1E293B"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desbloquear Base de Datos"
        android:backgroundTint="#0284C7"
        android:textColor="#FFFFFF"
        android:padding="14dp" />

</LinearLayout>
