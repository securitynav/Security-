<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_dark">

    <TextView
        android:id="@+id/tvVpnTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Private Local VPN"
        android:textColor="@color/neon_purple"
        android:textSize="24sp"
        android:layout_marginBottom="16dp"/>
        
    <TextView
        android:id="@+id/tvVpnStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VPN Status: DISCONNECTED"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnToggleVpn"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:text="Connect VPN"
        android:backgroundTint="@color/neon_green"
        android:textColor="@color/black"
        android:paddingHorizontal="32dp"
        android:textSize="16sp"/>
</LinearLayout>
