<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E17"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Métricas de Tráfico e Inspección en Tiempo Real"
        android:textColor="#00FF66"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lineChartTraffic"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#161D2F"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inspección de Tráfico por Aplicación"
        android:textColor="#00E5FF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAppTraffic"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
