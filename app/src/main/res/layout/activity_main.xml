<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <!-- Contenido Principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra Superior Neón corregida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#161D2F"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnOpenMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#00FF66" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SECURITY NAV"
                android:textColor="#00FF66"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- INTERRUPTOR PRINCIPAL: CANDADO DINÁMICO -->
                <com.securitynav.security.ui.CustomPulseLockView
                    android:id="@+id/btnMainLock"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginVertical="20dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvLockState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO: PROTECCIÓN ACTIVA"
                    android:textColor="#00FF66"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- TARJETA 1: CANALES HEURÍSTICOS & DEGRADACIÓN DE TORRE -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161D2F"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Análisis Heurístico y Red Móvil"
                            android:textColor="#00E5FF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/switchHeuristics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Canales Heurísticos de Malware"
                            android:textColor="#FFFFFF"
                            android:checked="true"
                            android:layout_marginTop="8dp" />

                        <Switch
                            android:id="@+id/switchTowerDegradation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Detección de Degradación de Torre"
                            android:textColor="#FFFFFF"
                            android:checked="true"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- TARJETA 2: ABUSO DE ACCESIBILIDAD Y TAPJACKING -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161D2F"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Protección de Interfaz y Permisos"
                            android:textColor="#00E5FF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/switchAccessibilityAbuse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Anti-Abuso de Servicios de Accesibilidad"
                            android:textColor="#FFFFFF"
                            android:checked="true"
                            android:layout_marginTop="8dp" />

                        <Switch
                            android:id="@+id/switchOverlayProtect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Anti-Superposiciones (Tapjacking)"
                            android:textColor="#FFFFFF"
                            android:checked="true"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- TARJETA 3: INSPECCIÓN DE TRÁFICO VPN -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#211E10"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VPN Local e Inspección de Paquetes por App"
                            android:textColor="#FFD600"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/switchVpnTraffic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Monitor de Tráfico de Red VPN"
                            android:textColor="#FFFFFF"
                            android:checked="true"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvAppTrafficDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Datos inspeccionados: 0 B | HTTP GET/POST por aplicación activo"
                            android:textColor="#BBBBBB"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="8dp" />

                        <Button
                            android:id="@+id/btnViewCharts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ABRIR GRÁFICAS DE TRÁFICO EN TIEMPO REAL"
                            android:backgroundTint="#FFD600"
                            android:textColor="#0A0E17"
                            android:layout_marginTop="12dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- TARJETA 4: ALMACENAMIENTO SEGURO HW KEYSTORE + SQLCIPHER -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161D2F"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Base de Datos Cifrada (SQLCipher + HW KeyStore)"
                            android:textColor="#00E5FF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Estado: Clave Maestra Protegida en Android Hardware KeyStore (TEE)."
                            android:textColor="#00FF66"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- Menú Lateral Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#161D2F"
        app:itemTextColor="#FFFFFF"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
