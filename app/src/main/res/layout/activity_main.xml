<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Contenido Principal -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface_dark"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnOpenMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/neon_green" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/main_title"
                android:textColor="@color/neon_green"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Blur background to create glass effect under cards -->
        <com.eightbitlab.blurview.BlurView
            android:id="@+id/blurView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="0dp"
            android:visibility="visible" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:layout_marginTop="56dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- INTERRUPTOR PRINCIPAL: CANDADO DINÁMICO -->
                <com.securitynav.security.ui.CustomPulseLockView
                    android:id="@+id/btnMainLock"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginVertical="20dp"
                    android:clickable="true"
                    android:focusable="true" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieLock"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="-140dp"
                    app:lottie_fileName="lottie/lock_animation.json"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="false" />

                <TextView
                    android:id="@+id/tvLockState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO: PROTECCIÓN ACTIVA"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- Quick Actions: VPN control and Diagnostics -->
                <androidx.constraintlayout.motion.widget.MotionLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutDescription="@xml/motion_scene_main">

                    <LinearLayout
                        android:id="@+id/quickActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_marginBottom="12dp">

                        <Button
                            android:id="@+id/btnStartVpn"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/action_start_vpn"
                            android:backgroundTint="@color/neon_green"
                            android:textColor="@color/on_primary" />

                        <Button
                            android:id="@+id/btnStopVpn"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/action_stop_vpn"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="@color/neon_red"
                            android:textColor="@color/text_primary" />

                        <Button
                            android:id="@+id/btnDiagnostics"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/action_diagnostics"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="@color/neon_yellow"
                            android:textColor="@color/on_secondary" />

                        <Button
                            android:id="@+id/btnAbout"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/action_about"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="@color/neon_cyan"
                            android:textColor="@color/on_primary" />

                    </LinearLayout>

                </androidx.constraintlayout.motion.widget.MotionLayout>

                <!-- Cards... (unchanged) -->

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Menú Lateral Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_dark"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
