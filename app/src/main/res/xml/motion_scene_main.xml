<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetStart="@id/start"
        motion:constraintSetEnd="@id/end"
        motion:duration="300">
        <OnClick motion:targetId="@id/btnMainLock" motion:clickAction="toggle" />
    </Transition>

    <ConstraintSet android:id="@+id/start">
        <Constraint android:id="@id/btnMainLock">
            <Layout android:width="140dp" android:height="140dp" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@id/btnMainLock">
            <Layout android:width="160dp" android:height="160dp" />
        </Constraint>
    </ConstraintSet>

</MotionScene>
